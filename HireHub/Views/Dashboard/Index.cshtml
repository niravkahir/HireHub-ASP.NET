@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">
    <h1>Welcome, @ViewBag.FullName 👋</h1>
    <p>You are logged in as: <strong>@string.Join(", ", ViewBag.Roles)</strong></p>
    <p>Email: @ViewBag.Email</p>

    <hr />

    @if (ViewBag.Roles.Contains("Admin"))
    {
        <div class="alert alert-danger">
            <h4>Admin Panel</h4>
            <p>You can manage users, jobs, and applications from here.</p>
            <a href="#" class="btn btn-outline-danger">Go to Admin</a>
        </div>
    }
    else if (ViewBag.Roles.Contains("Recruiter"))
    {
        <div class="alert alert-info">
            <h4>Recruiter Panel</h4>
            <p>Post jobs, manage company, and review applicants.</p>

            <a asp-controller="Company" asp-action="Index" class="btn btn-outline-info me-2">
                My Company
            </a>
            <a asp-controller="Job" asp-action="Index" class="btn btn-outline-info me-2">
                My Jobs
            </a>
            <a asp-controller="Job" asp-action="Create" class="btn btn-outline-info">
                Post a Job
            </a>
        </div>
    }
    else if (ViewBag.Roles.Contains("JobSeeker"))
    {
        <div class="alert alert-success">
            <h4>Job Seeker Panel</h4>
            <p>Browse jobs, apply, save for later, and track applications.</p>

            <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-success me-2">
                Browse Jobs
            </a>
            <a asp-controller="Application" asp-action="MyApplications" class="btn btn-outline-success">
                My Applications
            </a>
        </div>
    }
</div>