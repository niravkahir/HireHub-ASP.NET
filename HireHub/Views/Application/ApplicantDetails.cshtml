@model HireHub.Models.Entities.JobApplication
@using HireHub.Models.Enums
@{
    ViewData["Title"] = "Applicant Details";
    var applicant = Model.JobSeekerProfile.User;
}

<div class="container mt-4">
    <a asp-action="JobApplications" asp-route-id="@Model.JobId"
       class="btn btn-sm btn-outline-secondary mb-3">← Back to Applicants</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="row">
        <!-- Left: Applicant Info -->
        <div class="col-md-8">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h3>@applicant.FullName</h3>
                    <p class="text-muted mb-2">
                        Applied for: <strong>@Model.Job.Title</strong>
                    </p>

                    <ul class="list-unstyled">
                        <li>📧 <strong>Email:</strong> @applicant.Email</li>
                        <li>📞 <strong>Phone:</strong> @(applicant.PhoneNumber ?? "—")</li>
                        <li>📍 <strong>Location:</strong> @(Model.JobSeekerProfile.Location ?? "—")</li>
                        <li>🎓 <strong>Education:</strong> @(Model.JobSeekerProfile.Education ?? "—")</li>
                        <li>💼 <strong>Experience:</strong> @(Model.JobSeekerProfile.Experience ?? "—")</li>
                        <li>🛠️ <strong>Skills:</strong> @(Model.JobSeekerProfile.Skills ?? "—")</li>
                        <li>📅 <strong>Applied On:</strong> @Model.AppliedAt.ToString("dd MMM yyyy HH:mm")</li>
                    </ul>

                    @if (!string.IsNullOrEmpty(Model.ResumePath))
                    {
                        <a href="@Model.ResumePath" target="_blank" class="btn btn-outline-primary">
                            📄 View Resume
                        </a>
                    }
                    else
                    {
                        <span class="text-muted">No resume uploaded.</span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.CoverLetter))
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5>Cover Letter</h5>
                        <p class="mb-0" style="white-space: pre-wrap;">@Model.CoverLetter</p>
                    </div>
                </div>
            }
        </div>

        <!-- Right: Status + Interview -->
        <div class="col-md-4">
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <h5>Application Status</h5>

                    <p class="mb-2">
                        Current:
                        @{
                            var badgeClass = Model.Status switch
                            {
                                ApplicationStatus.Applied => "bg-secondary",
                                ApplicationStatus.UnderReview => "bg-warning text-dark",
                                ApplicationStatus.Shortlisted => "bg-info text-dark",
                                ApplicationStatus.InterviewScheduled => "bg-primary",
                                ApplicationStatus.Hired => "bg-success",
                                ApplicationStatus.Rejected => "bg-danger",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@Model.Status</span>
                    </p>

                    <form asp-action="UpdateStatus" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()

                        <label class="form-label">Update to:</label>
                        <select name="status" class="form-select mb-2">
                            <option value="1">Applied</option>
                            <option value="2">Under Review</option>
                            <option value="3">Shortlisted</option>
                            <option value="5">Rejected</option>
                            <option value="6">Hired</option>
                            @* Note: InterviewScheduled (4) can only be set via Schedule Interview button *@
                        </select>

                        <button type="submit" class="btn btn-primary w-100">Update Status</button>
                    </form>
                </div>
            </div>

            <!-- Interview Section -->
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5>Interview</h5>

                    @if (Model.Interview != null)
                    {
                        <p class="mb-1"><strong>📅 @Model.Interview.ScheduledAt.ToString("dd MMM yyyy HH:mm")</strong></p>
                        <p class="mb-1"><strong>💻 Mode:</strong> @Model.Interview.Mode</p>

                        @if (!string.IsNullOrEmpty(Model.Interview.Location))
                        {
                            <p class="mb-1"><strong>📍 Location:</strong> @Model.Interview.Location</p>
                        }

                        @if (!string.IsNullOrEmpty(Model.Interview.Notes))
                        {
                            <p class="mb-1"><strong>📝 Notes:</strong> @Model.Interview.Notes</p>
                        }

                        <a asp-controller="Interview" asp-action="Schedule" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary w-100 mt-2">
                            Edit Interview
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">No interview scheduled yet.</p>

                        <a asp-controller="Interview" asp-action="Schedule" asp-route-id="@Model.Id"
                           class="btn btn-success w-100">
                            📅 Schedule Interview
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>