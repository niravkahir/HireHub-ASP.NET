@{
    ViewData["Title"] = "Apply for Job";
    var job = ViewBag.Job as HireHub.Models.Entities.Job;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info">@TempData["Info"]</div>
            }

            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h3>Applying for: @job?.Title</h3>
                    <p class="text-muted mb-0">
                        🏢 @job?.Company?.Name — 📍 @job?.Location
                    </p>
                </div>
            </div>

            <form asp-action="Apply" asp-route-id="@job?.Id" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">@ViewBag.Error</div>
                }

                <div class="mb-3">
                    <label class="form-label">Cover Letter <span class="text-muted">(optional)</span></label>
                    <textarea name="coverLetter" class="form-control" rows="6"
                              placeholder="Tell the recruiter why you're a great fit..."></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Resume <span class="text-danger">*</span></label>
                    <input type="file" name="resumeFile" class="form-control" required
                           accept=".pdf,.doc,.docx" />
                    <small class="text-muted">
                        Accepted formats: PDF, DOC, DOCX. <strong>Required.</strong>
                    </small>
                    @if (ViewBag.ResumeError != null)
                    {
                        <div class="text-danger small mt-1">@ViewBag.ResumeError</div>
                    }
                </div>

                <button type="submit" class="btn btn-success">Submit Application</button>
                <a asp-controller="Browse" asp-action="Details" asp-route-id="@job?.Id"
                   class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>