@model HireHub.Models.Entities.Interview
@{
    ViewData["Title"] = "Schedule Interview";
    var application = ViewBag.Application as HireHub.Models.Entities.JobApplication;
    bool isEdit = application?.Interview != null;
}

<div class="container mt-4">
    <a asp-controller="Application" asp-action="ApplicantDetails" asp-route-id="@Model.JobApplicationId"
       class="btn btn-sm btn-outline-secondary mb-3">← Back to Applicant</a>

    <h2>@(isEdit ? "Edit Interview" : "Schedule Interview")</h2>
    <hr />

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5>@application?.JobSeekerProfile?.User?.FullName</h5>
            <p class="text-muted mb-0">
                📧 @application?.JobSeekerProfile?.User?.Email |
                📞 @(application?.JobSeekerProfile?.User?.PhoneNumber ?? "—") |
                💼 Applied for: <strong>@application?.Job?.Title</strong>
            </p>
        </div>
    </div>

    <form asp-action="Schedule" asp-route-id="@Model.JobApplicationId" method="post">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="JobApplicationId" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="ScheduledAt" class="form-label">Date & Time *</label>
                    <input asp-for="ScheduledAt" class="form-control" type="datetime-local"
                           asp-format="{0:yyyy-MM-ddTHH:mm}" />
                    <span asp-validation-for="ScheduledAt" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Mode" class="form-label">Mode</label>
                    <select asp-for="Mode" class="form-select">
                        <option value="Online">Online (Google Meet / Zoom)</option>
                        <option value="Onsite">Onsite (Office)</option>
                        <option value="Phone">Phone Call</option>
                    </select>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Location" class="form-label">Meeting Link / Address</label>
                    <input asp-for="Location" class="form-control"
                           placeholder="e.g. https://meet.google.com/abc-defg-hij OR Office address" />
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Notes for Candidate (optional)</label>
                    <textarea asp-for="Notes" class="form-control" rows="4"
                              placeholder="e.g. First technical round. Focus on C# fundamentals."></textarea>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                @(isEdit ? "Update Interview" : "Schedule Interview")
            </button>
            <a asp-controller="Application" asp-action="ApplicantDetails" asp-route-id="@Model.JobApplicationId"
               class="btn btn-secondary ms-2">Back</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}