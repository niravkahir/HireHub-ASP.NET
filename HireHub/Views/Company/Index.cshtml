@model HireHub.Models.Entities.Company
@{
    ViewData["Title"] = "My Company";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>My Company</h2>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.LogoPath))
                    {
                        <img src="@Model.LogoPath" class="img-fluid rounded" alt="Logo" style="max-height: 150px;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white text-center p-5 rounded">No Logo</div>
                    }
                </div>
                <div class="col-md-9">
                    <h3>@Model.Name</h3>
                    <p class="text-muted">📍 @Model.Location</p>
                    <p>@Model.Description</p>

                    @if (!string.IsNullOrEmpty(Model.Website))
                    {
                        <p>
                            🌐 <a href="@Model.Website" target="_blank">@Model.Website</a>
                        </p>
                    }

                    <p class="text-muted small">
                        Created: @Model.CreatedAt.ToString("dd MMM yyyy")
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>