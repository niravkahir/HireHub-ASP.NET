@{
    ViewData["Title"] = "Error " + ViewBag.Code;
    int code = ViewBag.Code ?? 404;
}

<div class="container mt-5">
    <div class="text-center py-5">
        <div style="font-size: 90px;">
            @if (code == 404)
            {
                <text>🔍</text>
            }
            else if (code == 403)
            {

                <text>🚫</text>
            }
            else
            {

                <text>⚠️</text>
            }
        </div>

        <h1 class="display-3 mt-3">@code</h1>
        <h4 class="text-muted">@ViewBag.Message</h4>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
                🏠 Go Home
            </a>
            <a asp-controller="Browse" asp-action="Index" class="btn btn-outline-secondary btn-lg">
                Browse Jobs
            </a>
        </div>
    </div>
</div>