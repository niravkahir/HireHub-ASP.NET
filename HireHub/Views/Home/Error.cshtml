@{
    ViewData["Title"] = "Error";
}

<div class="container mt-5">
    <div class="text-center py-5">
        <div style="font-size: 90px;">⚠️</div>
        <h1 class="display-3 mt-3">500</h1>
        <h4 class="text-muted">Something went wrong on our side</h4>
        <p class="lead mt-3">
            We're sorry — an unexpected error occurred. Please try again later.
        </p>

        <div class="mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg me-2">
                🏠 Go Home
            </a>
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-lg">
                ← Go Back
            </a>
        </div>

        <p class="text-muted small mt-4">
            If this keeps happening, please <a asp-controller="Support" asp-action="Create">contact support</a>.
        </p>
    </div>
</div>